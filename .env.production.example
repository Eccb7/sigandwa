# Production Environment Configuration
# Copy this to .env.production and update with your production values

# Database Configuration (Use managed database services in production)
POSTGRES_HOST=your-prod-db.example.com
POSTGRES_PORT=5432
POSTGRES_USER=sigandwa_prod
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=sigandwa_prod

NEO4J_URI=bolt://your-neo4j.example.com:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_THIS_SECURE_NEO4J_PASSWORD

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False  # IMPORTANT: Set to False in production

# Security (CRITICAL: Generate secure values)
SECRET_KEY=GENERATE_A_SECURE_RANDOM_KEY_HERE_USE_openssl_rand_hex_32
ALGORITHM=HS256

# CORS (Update with your production domains)
ALLOWED_ORIGINS=["https://yourdomain.com","https://api.yourdomain.com"]

# Application Settings
PROJECT_NAME=Sigandwa Biblical Cliodynamics
VERSION=0.1.0

# LLM Model Configuration
LLM_MODEL_NAME=lfm2-1.2b-rag
LLM_MODEL_PATH=/app/backend/models  # Use absolute path in production
LLM_QUANTIZATION=Q4_K_M
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7
LLM_CONTEXT_WINDOW=2048
LLM_N_THREADS=16  # Adjust based on your production server CPU cores

# Training Configuration
LLM_ENABLE_TRAINING=true
LLM_TRAINING_DATA_DIR=/app/data/training
LLM_LORA_RANK=16
LLM_LORA_ALPHA=32
LLM_LEARNING_RATE=0.0002

# Monitoring & Logging
LOG_LEVEL=INFO
SENTRY_DSN=  # Optional: Add Sentry for error tracking

# Rate Limiting (if using nginx/traefik)
RATE_LIMIT_PER_MINUTE=60

# SSL/TLS (if handling certificates in app)
SSL_CERT_PATH=/etc/ssl/certs/sigandwa.crt
SSL_KEY_PATH=/etc/ssl/private/sigandwa.key
